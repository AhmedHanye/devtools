{
  "name": "devtools",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
