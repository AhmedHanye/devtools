{
  "name": "devtools",
  "version": "0.0.0",
  "description": "Developer tooling monorepo providing development utilities and workflows across CLI, daemon, API, and frontend interfaces.",
  "license": "MIT",
  "author": "Ahmed Hanye",
  "repository": "https://github.com/AhmedHanye/devtools.git",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "site"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "oxlint . && prettier --check .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test && bun test scripts/",
    "test:coverage": "bun scripts/collect-coverage.ts",
    "build": "bun --filter '*' build",
    "build:smoke": "bun build apps/cli/bin/devtools.js --compile --outfile dist/devtools && ./dist/devtools --help",
    "audit": "bun audit --audit-level=high --ignore GHSA-vfj7-8cjw-p6xm",
    "pin:actions": ".agents/skills/github-actions/scripts/pin-action.sh",
    "lint:workflows": ".agents/skills/github-actions/scripts/lint.sh",
    "verify:fast": "bun run check && bun run typecheck && bunx fallow dead-code",
    "verify": "bun run verify:fast && bun --filter '*' lint:design && bun --filter '*' lint:fsd && bun run test && bun run audit && bun run build:smoke && bun run lint:workflows"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fallow": "^3.31.0",
    "lefthook": "^2.1.17",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  }
}
